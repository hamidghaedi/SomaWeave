          "type": "array"
        },
        "best_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/TreatmentResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date, or YYYY-MM / YYYY when only partial precision is recorded.",
          "title": "End Date"
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
