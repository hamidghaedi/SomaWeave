            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality"
        },
        "name": {
          "description": "Regimen or agent name as recorded.",
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "ongoing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
