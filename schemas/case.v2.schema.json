  "$id": "https://somaweave.local/schemas/case.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "age_at_diagnosis_years": {
      "anyOf": [
        {
          "maximum": 130,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Age At Diagnosis Years"
    },
    "alterations": {
      "items": {
        "$ref": "#/$defs/Alteration"
      },
      "title": "Alterations",
      "type": "array"
    },
    "assembly": {
      "$ref": "#/$defs/Assembly"
    },
    "case_id": {
      "description": "De-identified case identifier.",
      "title": "Case Id",
      "type": "string"
    },
    "clinical_events": {
      "items": {
        "$ref": "#/$defs/ClinicalEvent"
      },
      "title": "Clinical Events",
      "type": "array"
    },
    "diagnosis": {
      "$ref": "#/$defs/Diagnosis"
    },
    "disease_hypotheses": {
      "items": {
        "$ref": "#/$defs/DiseaseHypothesis"
      },
      "title": "Disease Hypotheses",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Source paths, SHA-256 values and explicit ingestion decisions; contains no derived interpretation.",
      "title": "Provenance",
      "type": "object"
    },
    "schema_version": {
      "default": "case.v2",
      "pattern": "^case\\.v[12]$",
      "title": "Schema Version",
      "type": "string"
    },
    "sex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Biological sex if relevant to interpretation.",
      "title": "Sex"
    },
    "specimens": {
      "items": {
        "$ref": "#/$defs/Specimen"
      },
      "minItems": 1,
      "title": "Specimens",
      "type": "array"
    },
    "treatments": {
      "items": {
        "$ref": "#/$defs/TreatmentEvent"
      },
      "title": "Treatments",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "assembly",
    "diagnosis",
    "specimens"
  ],
  "title": "Case",
  "type": "object"
}
