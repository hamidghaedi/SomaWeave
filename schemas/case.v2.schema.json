          "title": "Review Outcome"
        },
        "unique_templates_alt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Independent (deduplicated) templates supporting ALT.",
          "title": "Unique Templates Alt"
        },
        "unique_templates_ref": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Independent templates supporting REF.",
          "title": "Unique Templates Ref"
        },
        "unique_templates_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Independent templates covering the site, if reported separately.",
          "title": "Unique Templates Total"
        },
        "visual_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
